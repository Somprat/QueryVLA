# Machine-local environments and caches
**/.venv/
**/.runtime/
**/__pycache__/
**/.pytest_cache/
**/*.egg-info/

# Credentials
**/.hf_token
**/.*_token
**/.*api_key
.env

# Large downloaded models and generated evaluation logs
models/**/checkpoints/
models/**/eval_simpler/
models/memvla-libero-spatial/
myMemoryVLA/eval_simpler/
myMemoryVLA/logs/

# Hugging Face and Python caches
.cache/
**/pip-cache/

# Local editor and agent working files
/.codex_work/
/.vscode/
**/node_modules/
.DS_Store

# Local environment secrets (keep shareable templates)
.env.*
!.env.example
!.env.sample
!.env.template

# Training artifacts, including resumable checkpoint pairs and partial writes
*.pt
*.pth
*.safetensors
*.optimizer
*.pt.tmp
*.optimizer.tmp
**/wandb/

# Generated workbook inspection output
outputs/**/*.inspect.ndjson
